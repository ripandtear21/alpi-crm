{
  "name": "@alpi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "create-owner": "node --env-file-if-exists=../../.env src/cli/create-owner.ts",
    "project-preset": "node --env-file-if-exists=../../.env src/cli/project-preset.ts",
    "seed": "node --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@alpi/db": "workspace:*",
    "@alpi/shared": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.15",
    "hono": "4.13.16",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pg-connection-string": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.12.0",
    "vite": "8.3.5"
  }
}
