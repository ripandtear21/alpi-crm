{
  "name": "@alpi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "create-owner": "node --env-file-if-exists=../../.env src/cli/create-owner.ts"
  },
  "dependencies": {
    "@alpi/db": "workspace:*",
    "@alpi/shared": "workspace:*",
    "@hono/node-server": "2.1.6",
    "better-auth": "1.7.15",
    "hono": "4.13.16",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
