# Образец переменных окружения. Скопировать в .env и заполнить; .env в git не попадает.

# PostgreSQL в docker-compose
POSTGRES_USER=alpi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alpi_crm

# Строка подключения для API и мигратора (pnpm --filter @alpi/db migrate).
# В docker-compose её собирает сам compose из POSTGRES_*, здесь — для запуска вне контейнеров.
DATABASE_URL=postgres://alpi:change-me@localhost:5432/alpi_crm

# Порт API
PORT=3000

# Адрес сайта для Caddy: домен (Caddy выпустит TLS-сертификат) или :80 без TLS
SITE_ADDRESS=:80
