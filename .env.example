# Образец переменных окружения. Скопировать в .env и заполнить; .env в git не попадает.

# PostgreSQL в docker-compose. POSTGRES_USER — служебная роль: владелец таблиц, под ней идут
# миграции. API под ней не работает: на владельца таблиц row-level security не действует.
POSTGRES_USER=alpi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alpi_crm

# Роль входа API: член alpi_app, без SUPERUSER и BYPASSRLS. Её создаёт (или обновляет ей
# пароль) мигратор после миграций; в docker-compose это служба migrate.
APP_DB_USER=alpi_api
APP_DB_PASSWORD=change-me-too

# Строки подключения для запуска вне контейнеров (в docker-compose их собирает сам compose).
# Мигратор (pnpm --filter @alpi/db migrate) — служебной ролью:
MIGRATION_DATABASE_URL=postgres://alpi:change-me@localhost:5432/alpi_crm
# API и pnpm create-owner — ролью входа API; по ней же мигратор создаёт эту роль:
DATABASE_URL=postgres://alpi_api:change-me-too@localhost:5432/alpi_crm

# Порт API
PORT=3000

# Вход (Better Auth). Ключ подписи cookie и шифрования секретов 2FA — случайная строка
# не короче 32 символов: openssl rand -base64 32. С этим образцом API не запустится.
BETTER_AUTH_SECRET=change-me
# Публичный адрес сайта (origin), с которого открывают CRM, например https://crm.example.com.
# В разработке — адрес Vite.
BETTER_AUTH_URL=http://localhost:5173
# Прокси перед Caddy (балансировщик, CDN), которым API верит в X-Forwarded-For: адреса или
# подсети CIDR через запятую. Пусто — прокси один (Caddy), он ставит в заголовок один адрес
# клиента. Если прокси есть, а список пуст, адрес клиента не определяется и ограничитель
# попыток входа считает всех вместе. Caddy тогда тоже должен им верить (trusted_proxies).
TRUSTED_PROXIES=
# Только для запуска вне Docker: development снимает с cookie флаг Secure (сайт по http).
# В образе API всегда production.
NODE_ENV=development

# Каталог файлов пользователей (заметки и файлы к сделкам, контактам, организациям): абсолютный
# путь вне каталога приложения (apps/api) — его заменяет каждая сборка. В docker-compose задан
# сам (/data/files на томе files), здесь — для запуска вне Docker.
STORAGE_DIR=/var/lib/alpi-crm/files

# События на адреса автоматизации (тикет crm-api/06). Ключ, которым в базе зашифрованы секреты
# подписи адресов: base64 от 32 случайных байт (openssl rand -base64 32). Не задан — адреса
# событий не создаются и события не отправляются. Сменить ключ — значит потерять секреты всех
# адресов (их придётся сменить заново).
WEBHOOK_SECRET_KEY=
# Только для автотестов и разработки: 1 — адреса событий по http:// и на localhost. С
# NODE_ENV=production API с ней не запускается.
WEBHOOK_ALLOW_INSECURE_URLS=0

# Адрес сайта для Caddy: домен (Caddy выпустит TLS-сертификат) или :80 без TLS
SITE_ADDRESS=:80
