{
  "name": "alpi-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "create-owner": "pnpm --filter @alpi/api create-owner"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
